# Kredensial SSO PENS
ETHOL_EMAIL=email_kamu@student.pens.ac.id
ETHOL_PASSWORD=password_sso_kamu

# Konfigurasi Telegram Bot
TELEGRAM_BOT_TOKEN=token_bot_dari_botfather
TELEGRAM_CHAT_ID=chat_id_kamu

# Interval Pengecekan Presensi (dalam detik, default 30 detik)
CHECK_INTERVAL_SECONDS=30

# Timezone
TIMEZONE=Asia/Jakarta

# Konfigurasi ID Topik Forum Telegram (Opsional, untuk mode Group Topics/Forum)
# Dapatkan ID topik dengan mengetik /getid di dalam topik Telegram terkait
TOPIC_PRESENSI_ID=
TOPIC_MATERI_ID=
TOPIC_TUGAS_ID=
TOPIC_JADWAL_ID=
TOPIC_SERVER_ID=
TOPIC_STATUS_ID=
TOPIC_GENERAL_ID=
